# Etapa 1: Construcción (Maven)
FROM maven:3.8.5-openjdk-17-slim AS build
WORKDIR /app

# Copiar el archivo de configuración de Maven
COPY pom.xml .
# Descargar dependencias para cachear esta capa
RUN mvn dependency:go-offline

# Copiar el código fuente y compilar
COPY src ./src
RUN mvn clean package -DskipTests

# Etapa 2: Imagen de ejecución (Ligera)
FROM openjdk:17-jdk-slim
WORKDIR /app

# Seguridad: Crear usuario no root (Requisito de la pauta)
RUN addgroup --system spring && adduser --system spring --ingroup spring
USER spring:spring

# Copiar el JAR generado desde la etapa de build
COPY --from=build /app/target/*.jar app.jar

# Exponer el puerto que usa este microservicio (ajustar si es distinto a 8080)
EXPOSE 8080

ENTRYPOINT ["java", "-jar", "app.jar"]